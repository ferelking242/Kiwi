# Eterna Browser — GN Build Configuration
# AIVOS — com.aivos.eterna
# target: arm64-v8a only

declare_args() {
  eterna_package_name    = "com.aivos.eterna"
  eterna_app_label       = "Eterna"
  eterna_version_name    = "1.0.0"
  eterna_version_code    = 1000000
  eterna_min_sdk_version = 23
  eterna_target_cpu      = "arm64"
}

# Shared GN args for all Eterna targets
eterna_common_args = {
  target_os = "android"
  target_cpu = "arm64"
  is_debug = false
  is_official_build = true
  is_component_build = false
  enable_nacl = false
  chrome_pgo_phase = 0
  android_channel = "stable"
  android_default_version_name = eterna_version_name
  android_default_version_code = eterna_version_code
  ffmpeg_branding = "Chrome"
  proprietary_codecs = true
  fieldtrial_testing_like_official_build = true
}
